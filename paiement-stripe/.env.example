# Copier ce fichier vers .env puis remplacer les valeurs.
# Aucune clé réelle ne doit être commitée.

# MySQL — format non précisé dans le PDF. Exemple pour le docker-compose local :
DATABASE_URL="mysql://stripe:stripe@localhost:3306/paiement_stripe"

# NextAuth — noms non listés dans le PDF, ce sont ceux de la documentation NextAuth v4
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="remplacez-par-une-chaine-longue-generee"

# OAuth optionnel. Laissez vide pour n'utiliser que l'email et le mot de passe.
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe — clés de test (sk_test_ / pk_test_), jamais les clés live dans le dépôt
STRIPE_SECRET_KEY=""
# Nom exact utilisé par le PDF (PayNowButton)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""
