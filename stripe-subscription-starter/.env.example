# Le PDF demande un fichier .env.local. Copiez celui-ci :
#   Copy-Item .env.example .env.local
# Ne mettez aucune clé réelle dans le dépôt.

# MySQL. Port 3307 pour ne pas entrer en conflit avec paiement-stripe (3306).
DATABASE_URL="mysql://stripe:stripe@localhost:3307/stripe_subscription"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="remplacez-par-une-chaine-longue-generee"

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Créez trois prix récurrents mensuels dans le Dashboard Stripe :
# Basic 10 €, Premium 25 €, Pro 50 €, puis collez les priceId ici.
# Le PDF montre des exemples d'un autre compte, inutilisables tels quels :
# price_1Rt8UoFmHtWgxaoniYlQAU9a
# price_1Rt8W1FmHtWgxaonrn5uWy7y
# price_1RtacMFmHtWgxaon6Uz74qtQ
NEXT_PUBLIC_STRIPE_PRICE_BASIC=""
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""
